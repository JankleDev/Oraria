	"calculate_hud": {
		"$update_string": "updateHUD",
		"type": "label",
		"text": "#text",
		"visible": true,
		"size": [0, 0],
		"controls": [
			{
				"data_control": {
					"type": "panel",
					"size": [0, 0],
					"bindings": [
						{
							"binding_name": "#hud_title_text_string"
						},
						{
							"binding_name": "#hud_title_text_string",
							"binding_name_override": "#preserved_text",
							"binding_condition": "visibility_changed"
						}
					]
				}
			}
		],
		"bindings": [
			{
				"binding_type": "view",
				"source_control_name": "data_control",
				"source_property_name": "(#preserved_text - $update_string)",
				"target_property_name": "#text"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#text - ':')",
				"target_property_name": "#health"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#text - (':' + #health + ', ')",
				"target_property_name": "#focus"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#text - (':' + #health + ', ' + #focus + ', ')",
				"target_property_name": "#stamina"
			}
		]
	},
	"derivatives_factory": {
		"type": "panel",
		"factory": {
			"name": "hud_title_text_factory",
			"control_ids": {
				"hud_title_text": "derivatives@custom_hud.derivatives"
			}
		}
	}
}
