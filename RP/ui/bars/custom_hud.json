					"visible": true
				}
			},
			{
				"health_bar": {
					"type": "image",
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"size": [238, 8],
					"offset": [79, 31],
					"uv": [0, 97],
					"uv_size": [238, 8],
					"layer": 32,
					"$one": 1,
					"$max_clip": 100.0,
					"clip_direction": "left",
