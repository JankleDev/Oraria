					"size": [184, 4],
					"offset": [82, 43],
					"uv": [0, 113],
					"uv_size": [184, 4],
					"layer": 32,
					"$one": 1,
					"$max_clip": 100.0,
					"clip_direction": "left",
					"clip_pixelperfect": false,
					"texture": "textures/ui/hud_sprite",
					"bindings": [
						{
							"binding_type": "view",
							"source_control_name": "calculate_hud",
							"source_property_name": "(($max_clip - #focus) / $max_clip)",
							"target_property_name": "#clip_ratio"
